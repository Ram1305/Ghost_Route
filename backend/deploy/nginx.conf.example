# Example nginx reverse proxy for HTTPS termination.
# Point api.yencodetech.com DNS to your server, then:
#   certbot --nginx -d api.yencodetech.com
#   npm run seed:all && npm start

server {
    listen 443 ssl http2;
    server_name api.yencodetech.com;

    ssl_certificate     /etc/letsencrypt/live/api.yencodetech.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.yencodetech.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:2626;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name api.yencodetech.com;
    return 301 https://$host$request_uri;
}
