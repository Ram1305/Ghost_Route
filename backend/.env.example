PORT=2626
MONGODB_URI=mongodb://localhost:27017/ghostroute

# Email (OTP, welcome, invoice)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Legacy Razorpay (not used by mobile app; optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# In-App Purchase verification (required for production iOS/Android)
APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=com.yencode.ghostroute
GOOGLE_PLAY_PACKAGE_NAME=com.yencode.ghostroute
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=
# Set to false only for local dev without store credentials
IAP_STRICT_VERIFY=true
